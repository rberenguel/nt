{
  "manifest_version": 3,
  "name": "NT",
  "version": "1.6.4",
  "description": "Replaces the default new tab page with a custom one",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["storage", "notifications", "system.display", "windows"],
  "host_permissions": [
    "https://api.radioswissjazz.ch/*",
    "https://api.radioswisspop.ch/*",
    "https://api.radioswissclassic.ch/*",
    "https://nightride.fm/*",
    "https://www.rockantenne.de/*",
    "https://api.laut.fm/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["media/icon.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "128": "media/icon.png"
  }
}
